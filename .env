# ---------------------------------------------------------------------------
# ResearchForge configuration
# Copy this file to ".env" and edit. Every value is optional: the app runs with
# anonymous / rate-limited public API access if nothing is configured.
# ---------------------------------------------------------------------------

# --- server -----------------------------------------------------------------
RF_HOST=127.0.0.1
RF_PORT=8000
RF_OPEN_BROWSER=1

# --- storage ----------------------------------------------------------------
# Relative paths are resolved against the project root.
RF_DATA_DIR=data
RF_DB_PATH=data/researchforge.db
RF_CACHE_DIR=data/http_cache
RF_DOWNLOAD_DIR=data/downloads

# --- outbound HTTP ----------------------------------------------------------
RF_HTTP_TIMEOUT=25
RF_HTTP_MAX_RETRIES=3
RF_HTTP_BACKOFF_BASE=0.8
RF_CACHE_TTL_SECONDS=3600
RF_MAX_CONCURRENT_REQUESTS=6

# Polite identification (several APIs give better rate limits with a mailto).
RF_CONTACT_EMAIL=
RF_USER_AGENT=ResearchForge/1.0 (local research client)

# --- source credentials (all optional) --------------------------------------
# Semantic Scholar works anonymously but is heavily rate limited without a key.
SEMANTIC_SCHOLAR_API_KEY=
# Hugging Face token enables private/gated dataset metadata lookups.
HUGGINGFACE_TOKEN=
# data.gov / CKAN catalog API key (optional, increases rate limit).
DATAGOV_API_KEY=

# --- search defaults --------------------------------------------------------
RF_DEFAULT_SEARCH_DEPTH=2
RF_DEFAULT_PAGE_SIZE=25
RF_MAX_RESULTS_PER_SOURCE=120

# --- optional LLM (never used as a source of retrieved facts) ---------------
# Any OpenAI-compatible chat-completions endpoint. Leave RF_LLM_API_KEY empty
# to run fully deterministically without a language model.
RF_LLM_BASE_URL=
RF_LLM_API_KEY=
RF_LLM_MODEL=
RF_LLM_TIMEOUT=60
